APP_NAME=QuestLab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- QBL ---------------------------------------------------------------------------------
# Shared secret for the game server's calls to /api/internal.
QBL_SERVICE_KEY=
QBL_ALLOW_GUESTS=true

# Behind a TLS-terminating proxy: whose X-Forwarded-* headers to believe (comma-separated).
# Left unset, every private range and localhost. Set APP_URL above to the https address.
#TRUSTED_PROXIES=10.0.0.5

# Sign in with Google: on when both are set. Redirect URI to register: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these domains may sign in with Google (comma-separated). Empty: any Google account.
QBL_GOOGLE_DOMAINS=

# ---- AI scenario generator (php artisan qbl:generate) -----------------------------------------
# Running outside Docker: the work folder for each run (default storage/app/generations).
QBL_GEN_WORK_DIR=
# Every setting of the generator is here. Left empty, the default shown is used.
# See docs/src/content/docs/developers/generation.md.

# Claude writes the mission, aligns it to standards and checks every picture against the art style.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
QBL_GEN_LLM_MODEL=claude-opus-5-5
QBL_GEN_JUDGE_MODEL=claude-sonnet-5-5

# What draws the pictures: gemini, openai, scenario, or placeholder (no service; for trying it out).
QBL_GEN_IMAGE_DRIVER=gemini

# Google Gemini. gemini-3-pro-image (Nano Banana Pro) or gemini-3.1-flash-image (Nano Banana 2, about half the price).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
QBL_GEN_GEMINI_MODEL=gemini-3-pro-image
# 1K, 2K or 4K
QBL_GEN_GEMINI_IMAGE_SIZE=2K

# OpenAI GPT Image. Quality: low, medium or high.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
QBL_GEN_OPENAI_MODEL=gpt-image-2
QBL_GEN_OPENAI_QUALITY=high

# Scenario (scenario.com), with a model trained on the house style.
SCENARIO_API_KEY=
SCENARIO_API_SECRET=
SCENARIO_MODEL_ID=
SCENARIO_BASE_URL=https://api.cloud.scenario.com/v1

# The art style: a folder in apps/api/resources/art-styles (qbl-adventure, qbl-cartoon).
QBL_GEN_STYLE=qbl-adventure
# Check every picture against the style's anchors, and redraw below this score (out of 10).
QBL_GEN_JUDGE=true
QBL_GEN_JUDGE_MIN_SCORE=7
QBL_GEN_MAX_ATTEMPTS=3

# The most one mission may have.
QBL_GEN_MAX_SCENES=8
QBL_GEN_MAX_CHARACTERS=6
QBL_GEN_MAX_ITEMS=14

# Where standards are imported from (php artisan qbl:standards). A JSON file needs neither.
LEARNING_COMMONS_API_KEY=
LEARNING_COMMONS_BASE_URL=https://api.learningcommons.org/knowledge-graph/v0
CSP_API_KEY=
CSP_BASE_URL=https://api.commonstandardsproject.com/api/v1

# Plans, Stripe and generator credits (see the root .env.example for all of them).
QBL_BILLING_ENABLED=false
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEACHER=
STRIPE_PRICE_TEACHER_PLUS=

# Clever, for the district admin panel.
CLEVER_CLIENT_ID=
CLEVER_CLIENT_SECRET=
