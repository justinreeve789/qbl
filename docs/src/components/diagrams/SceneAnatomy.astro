---
// A scene, labelled: what you place in the scene editor and what each part does.
import { getImage } from 'astro:assets';
import { CAST } from '../cast';

interface Props { caption?: string }
const { caption = 'A schoolyard scene with everything the scene editor can place in it. The numbers match the list.' } = Astro.props;
const lucy = (await getImage({ src: CAST.lucy.picture, height: 260 })).src;
const pinta = (await getImage({ src: CAST.pinta.picture, height: 260 })).src;
const parts = [
  ['Background layers', 'The picture (or pictures, back to front) the scene is drawn with.'],
  ['Walkable area', 'Players walk only inside it. Here: the grass.'],
  ['Spawn points', 'Where players arrive: default when they start, east when they come back.'],
  ['Hotspot', 'A spot players click (or walk into) that runs actions. Its label tells them it is there.'],
  ['Character', 'Someone to talk to. When clicked, runs an event: usually a conversation.'],
  ['Exit', 'A walk-in hotspot along an edge whose action jumps to another scene.'],
  ['Start event', 'Runs when a player arrives, like a welcome message.'],
];
---

<figure class="qd qd-scene">
  <svg viewBox="0 0 800 450" role="img" aria-labelledby="qd-scene-t">
    <title id="qd-scene-t">A labelled scene: background, walkable area, spawn points, a hotspot, a character, an exit and a start event</title>
    <defs>
      <linearGradient id="qd-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8fd3ff" /><stop offset="1" stop-color="#dff3ff" /></linearGradient>
      <linearGradient id="qd-grass" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7ccf5b" /><stop offset="1" stop-color="#4fa83d" /></linearGradient>
      <pattern id="qd-exit" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="5" height="10" fill="#f59f00" opacity="0.35" /></pattern>
    </defs>
    <!-- 1 Background -->
    <rect width="800" height="450" rx="14" fill="url(#qd-sky)" />
    <circle cx="700" cy="70" r="34" fill="#ffe066" />
    <g fill="#fff" opacity="0.9"><ellipse cx="160" cy="70" rx="48" ry="16" /><ellipse cx="195" cy="58" rx="30" ry="16" /><ellipse cx="520" cy="95" rx="40" ry="12" /></g>
    <rect x="40" y="130" width="250" height="175" fill="#e8b07a" stroke="#9a5b2c" stroke-width="3" />
    <polygon points="25,135 165,70 305,135" fill="#c0504d" stroke="#8a2f2c" stroke-width="3" />
    <rect x="135" y="225" width="50" height="80" fill="#7a4a24" />
    <g fill="#bfe6ff" stroke="#9a5b2c" stroke-width="2"><rect x="70" y="170" width="45" height="35" /><rect x="205" y="170" width="45" height="35" /></g>
    <path d="M0 300 H800 V436 a14 14 0 0 1 -14 14 H14 a14 14 0 0 1 -14 -14 Z" fill="url(#qd-grass)" />
    <ellipse cx="610" cy="300" rx="120" ry="14" fill="#5aa1d6" opacity="0.5" />
    <!-- 4 Hotspot: a notice board -->
    <rect x="335" y="230" width="70" height="48" rx="4" fill="#c98b4a" stroke="#7a4a24" stroke-width="3" />
    <rect x="344" y="238" width="22" height="16" fill="#fff" /><rect x="372" y="240" width="24" height="12" fill="#ffd43b" />
    <rect x="365" y="278" width="10" height="34" fill="#7a4a24" />
    <circle cx="370" cy="262" r="52" fill="none" stroke="#e64980" stroke-width="3" stroke-dasharray="8 6" />
    <rect x="318" y="187" width="104" height="22" rx="11" fill="#fff" stroke="#e64980" stroke-width="2" />
    <text x="370" y="202" text-anchor="middle" class="qd-sc-label" fill="#222">Notice board</text>
    <!-- 2 Walkable area -->
    <rect x="8" y="318" width="784" height="124" rx="10" fill="#ffffff" fill-opacity="0.12" stroke="#ffffff" stroke-width="3" stroke-dasharray="12 8" />
    <!-- 6 Exit -->
    <rect x="730" y="300" width="62" height="142" fill="url(#qd-exit)" stroke="#f59f00" stroke-width="2.5" stroke-dasharray="6 4" />
    <path d="M745 372 h26 m-9 -10 l10 10 l-10 10" stroke="#7a4a00" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    <text x="761" y="404" text-anchor="middle" class="qd-sc-small" fill="#5c3b00">to pond</text>
    <!-- 3 Spawn points -->
    <g><path d="M180 420 c0 -14 -14 -20 -14 -32 a14 14 0 0 1 28 0 c0 12 -14 18 -14 32z" fill="#339af0" stroke="#fff" stroke-width="2" /><circle cx="180" cy="388" r="5" fill="#fff" /></g>
    <g><path d="M640 420 c0 -14 -14 -20 -14 -32 a14 14 0 0 1 28 0 c0 12 -14 18 -14 32z" fill="#339af0" stroke="#fff" stroke-width="2" /><circle cx="640" cy="388" r="5" fill="#fff" /></g>
    <text x="640" y="437" text-anchor="middle" class="qd-sc-small" fill="#0b3d66">east</text>
    <!-- the player, arrived at default -->
    <image href={lucy} x="148" y="290" height="130" width="94" />
    <text x="196" y="437" text-anchor="middle" class="qd-sc-small" fill="#0b3d66">default · a player</text>
    <!-- 5 Character, facing the player -->
    <ellipse cx="520" cy="418" rx="34" ry="7" fill="#000" opacity="0.18" />
    <image href={pinta} x="490" y="290" height="130" width="63" transform="translate(1043 0) scale(-1 1)" />
    <rect x="470" y="262" width="100" height="22" rx="11" fill="#fff" stroke="#40c057" stroke-width="2" />
    <text x="520" y="277" text-anchor="middle" class="qd-sc-label" fill="#222">💬 Click to talk</text>
    <!-- 7 Start event -->
    <rect x="14" y="14" width="150" height="28" rx="14" fill="#1b1b1f" opacity="0.8" />
    <text x="89" y="33" text-anchor="middle" class="qd-sc-label" fill="#fff">🎬 Welcome!</text>
    <!-- numbers -->
    {[
      [26, 120], [30, 352], [212, 400], [432, 236], [568, 330], [742, 288], [176, 28],
    ].map(([x, y], i) => (
      <g class="qd-sc-num"><circle cx={x} cy={y} r="13" /><text x={x} y={y + 5} text-anchor="middle">{i + 1}</text></g>
    ))}
  </svg>
  <ol class="qd-sc-parts">
    {parts.map(([name, what]) => <li><strong>{name}</strong>: <span class="qd-muted">{what}</span></li>)}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .qd-scene svg { border-radius: 14px; box-shadow: 0 6px 20px rgb(0 0 0 / 0.18); }
  .qd-sc-label { font-size: 13px; font-weight: 700; font-family: var(--sl-font); }
  .qd-sc-small { font-size: 11.5px; font-weight: 700; font-family: var(--sl-font); }
  .qd-sc-num circle { fill: #1b1b1f; stroke: #ffd43b; stroke-width: 2.5; }
  .qd-sc-num text { fill: #ffd43b; font-size: 14px; font-weight: 800; font-family: var(--sl-font); }
  .qd-sc-parts { columns: 2; column-gap: 1.5rem; margin: 1rem 0 0; padding-left: 1.4rem; }
  .qd-sc-parts li { break-inside: avoid; margin: 0 0 0.35rem; }
  .qd-sc-parts li::marker { font-weight: 800; color: var(--sl-color-accent-high); }
  @media (max-width: 44rem) { .qd-sc-parts { columns: 1; } }
</style>
