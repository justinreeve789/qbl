---
// A sequence diagram: who talks to whom, in order.
//   <Sequence
//     actors={[{ id: 'b', label: 'Browser', icon: '🧑‍🎓' }, { id: 's', label: 'Your server', who: 'buck' }]}
//     steps={[{ from: 'b', to: 's', text: 'clicks Open' }, { from: 's', to: 'b', text: '302', reply: true }, { at: 's', note: 'checks the user' }]}
//   />
import { getImage } from 'astro:assets';
import { CAST, type CastName } from '../cast';

interface Actor { id: string; label: string; sub?: string; icon?: string; who?: CastName }
type Step =
  | { from: string; to: string; text: string; reply?: boolean }
  | { at: string; note: string };
interface Props { actors: Actor[]; steps: Step[]; caption?: string }

const { actors, steps, caption } = Astro.props;
const W = 760;
const margin = 95;
const headH = 74;
const rowH = 46;
const col = (id: string) => {
  const i = actors.findIndex((a) => a.id === id);
  if (i < 0) throw new Error(`Sequence: unknown actor ${id}`);
  return actors.length === 1 ? W / 2 : margin + (i * (W - 2 * margin)) / (actors.length - 1);
};
const H = headH + 24 + steps.length * rowH + 10;
const faces = await Promise.all(
  actors.map(async (a) => (a.who ? (await getImage({ src: CAST[a.who].portrait, width: 96, height: 96 })).src : null)),
);
let n = 0;
const rows = steps.map((s, i) => {
  const y = headH + 24 + i * rowH + 26;
  if ('note' in s) return { kind: 'note' as const, x: Math.min(Math.max(col(s.at), 135), W - 135), y, text: s.note };
  n += 1;
  return { kind: 'msg' as const, x1: col(s.from), x2: col(s.to), y, text: s.text, reply: !!s.reply, n };
});
const uid = `seq${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="qd qd-seq">
  <div class="qd-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={caption ?? 'Sequence diagram'} style="min-width: 600px">
      <defs>
        <marker id={`${uid}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" class="qd-seq-head" />
        </marker>
        <marker id={`${uid}-r`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" class="qd-seq-head qd-seq-head--reply" />
        </marker>
        {actors.map((a, i) => faces[i] && (
          <clipPath id={`${uid}-c${i}`}><circle cx={col(a.id) - 52} cy="30" r="17" /></clipPath>
        ))}
      </defs>
      {actors.map((a, i) => {
        const x = col(a.id);
        return (
          <g>
            <line x1={x} x2={x} y1={headH - 8} y2={H - 6} class="qd-seq-life" />
            <rect x={x - 78} y="6" width="156" height={headH - 14} rx="12" class="qd-seq-actor" />
            {faces[i] ? (
              <>
                <circle cx={x - 52} cy="30" r="19" class="qd-seq-ring" style={`stroke: ${CAST[a.who!].color}`} />
                <image href={faces[i]!} x={x - 69} y="13" width="34" height="34" clip-path={`url(#${uid}-c${i})`} />
              </>
            ) : a.icon ? (
              <text x={x - 52} y="38" text-anchor="middle" class="qd-seq-icon">{a.icon}</text>
            ) : null}
            <text x={x - 28} y={a.sub ? 29 : 35} class="qd-seq-label">{a.label}</text>
            {a.sub && <text x={x - 28} y="46" class="qd-seq-sub">{a.sub}</text>}
          </g>
        );
      })}
      {rows.map((r) =>
        r.kind === 'note' ? (
          <g>
            <rect x={r.x - 130} y={r.y - 20} width="260" height="30" rx="8" class="qd-seq-note" />
            <text x={r.x} y={r.y} text-anchor="middle" class="qd-seq-notetext">{r.text}</text>
          </g>
        ) : (
          <g>
            <line
              x1={r.x1 + (r.x2 > r.x1 ? 4 : -4)} x2={r.x2 + (r.x2 > r.x1 ? -4 : 4)} y1={r.y} y2={r.y}
              class:list={['qd-seq-msg', { 'qd-seq-reply': r.reply }]} marker-end={`url(#${uid}-${r.reply ? 'r' : 'a'})`}
            />
            <circle cx={Math.min(r.x1, r.x2) + 16} cy={r.y - 13} r="9" class="qd-seq-n" />
            <text x={Math.min(r.x1, r.x2) + 16} y={r.y - 9} text-anchor="middle" class="qd-seq-ntext">{r.n}</text>
            <text x={(r.x1 + r.x2) / 2 + 8} y={r.y - 8} text-anchor="middle" class="qd-seq-text">{r.text}</text>
          </g>
        ),
      )}
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .qd-seq-life { stroke: var(--qd-line); stroke-width: 1.5; stroke-dasharray: 4 5; }
  .qd-seq-actor { fill: var(--qd-card); stroke: var(--qd-border); stroke-width: 1.5; }
  .qd-seq-ring { fill: var(--sl-color-gray-6); stroke-width: 3; }
  .qd-seq-icon { font-size: 22px; }
  .qd-seq-label { fill: var(--sl-color-white); font-weight: 700; font-size: 14px; }
  .qd-seq-sub { fill: var(--sl-color-gray-3); font-size: 11px; }
  .qd-seq-msg { stroke: var(--sl-color-accent); stroke-width: 2; }
  .qd-seq-reply { stroke: var(--sl-color-gray-3); stroke-dasharray: 6 4; }
  .qd-seq-head { fill: var(--sl-color-accent); }
  .qd-seq-head--reply { fill: var(--sl-color-gray-3); }
  .qd-seq-text { fill: var(--sl-color-white); font-size: 14px; }
  .qd-seq-n { fill: var(--sl-color-accent); }
  .qd-seq-ntext { fill: var(--sl-color-black); font-size: 11px; font-weight: 700; }
  .qd-seq-note { fill: color-mix(in srgb, var(--sl-color-accent) 14%, var(--qd-card)); stroke: color-mix(in srgb, var(--sl-color-accent) 60%, transparent); }
  .qd-seq-notetext { fill: var(--sl-color-white); font-size: 12.5px; font-style: italic; }
</style>
