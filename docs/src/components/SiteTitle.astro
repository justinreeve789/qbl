---
// The docs live under /docs/ in the same site as the game, so the header carries a way home:
// a round arrow button (the marketing page, `/`) beside the docs title (which goes to the docs home).
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<div class="title-row">
  <a href="/" class="back-home" aria-label="Back to the QuestLab site">
    <span aria-hidden="true">←</span>
  </a>
  <Default><slot /></Default>
</div>

<style>
  .title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .back-home {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 50%;
    color: var(--sl-color-text);
    font-size: var(--sl-text-base);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .back-home:hover,
  .back-home:focus-visible {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }
</style>
