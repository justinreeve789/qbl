---
// The docs live under /docs/ in the same site as the game, so the header carries a way home:
// a "QuestLab" pill (the marketing page, `/`) beside the docs title (which goes to the docs home).
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<div class="title-row">
  <a href="/" class="back-home" aria-label="Back to the QuestLab site">
    <span aria-hidden="true">←</span> <span class="back-label">QuestLab</span>
  </a>
  <Default><slot /></Default>
</div>

<style>
  .title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .back-home {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-text);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .back-home:hover,
  .back-home:focus-visible {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }
  /* Tight phones: the arrow alone is enough, and the title keeps its room. */
  @media (max-width: 30rem) {
    .back-label { display: none; }
    .back-home { padding: 0.25rem 0.6rem; }
  }
</style>
