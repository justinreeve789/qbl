---
// One of a mission's characters, with a line they say:
//   <Speaker name="Clockkeeper Amara" role="Guide. Asks, never tells.">“Where will it be at lunch?”</Speaker>
// Without a line, the role is shown as a description of the character.
interface Props {
  name: string;
  role?: string;
}

const { name, role } = Astro.props;
const says = Astro.slots.has('default');
// The same character gets the same colour wherever they appear.
const palette = ['#339af0', '#2fb344', '#8b5cf6', '#f59f00', '#e64980', '#15aabf'];
const color = palette[[...name].reduce((n, c) => n + c.charCodeAt(0), 0) % palette.length];
const initial = (name.replace(/^(The|A|An|Dr\.|Mr\.|Mrs\.|Ms\.)\s+/i, '').match(/\p{L}/u) ?? ['?'])[0]!.toUpperCase();
---

<div class="bp-speaker not-content" style={`--tone: ${color}`}>
  <div class="bp-speaker__face" aria-hidden="true">{initial}</div>
  <div class="bp-speaker__body">
    <p class="bp-speaker__name">{name}</p>
    {role && <p class="bp-speaker__role">{role}</p>}
    {says && <blockquote class="bp-speaker__says"><slot /></blockquote>}
  </div>
</div>

<style>
  .bp-speaker { display: flex; gap: 0.85rem; align-items: flex-start; margin-block: 1rem; }
  .bp-speaker__face {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--sl-color-white);
    background: color-mix(in srgb, var(--tone) 28%, var(--sl-color-bg));
    border: 2px solid var(--tone);
    box-shadow: 0 3px 0 color-mix(in srgb, var(--tone) 35%, transparent);
  }
  .bp-speaker__body { min-width: 0; flex: 1; }
  .bp-speaker__name { margin: 0; font-weight: 700; color: var(--sl-color-white); line-height: 1.3; }
  .bp-speaker__role { margin: 0.1rem 0 0; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); line-height: 1.45; }
  .bp-speaker__says {
    position: relative;
    margin: 0.5rem 0 0;
    padding: 0.6rem 0.9rem;
    border: 1.5px solid color-mix(in srgb, var(--tone) 55%, transparent);
    border-radius: 0.2rem 0.9rem 0.9rem 0.9rem;
    background: color-mix(in srgb, var(--tone) 9%, var(--sl-color-bg));
    color: var(--sl-color-white);
    line-height: 1.55;
  }
</style>
