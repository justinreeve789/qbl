# Port the site is published on.
QBL_HTTP_PORT=8080

# Set these for anything beyond your own machine. Without them, local-only defaults are used.
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Shared secret between the Colyseus server and Laravel's /api/internal routes.
QBL_SERVICE_KEY=
# Laravel application key. Left empty, one is generated and kept in the app-data volume.
APP_KEY=

# Optional: "docker compose exec app php artisan qbl:seed" then also creates teacher@qbl.test,
# student1@qbl.test and student2@qbl.test with this password. The teacher can use the editor at /editor.
QBL_SEED_PASSWORD=
# The demo mission allows guests. Set to false to require accounts.
QBL_ALLOW_GUESTS=true

# ---- HTTPS -------------------------------------------------------------------------------
# The containers speak plain HTTP; TLS ends at your firewall or load balancer.
# The address people type, with https:
QBL_PUBLIC_URL=
# The address the published port listens on. Bind it where only the firewall can reach it.
QBL_HTTP_BIND=0.0.0.0
# Whose X-Forwarded-Proto / X-Forwarded-For headers are believed (comma-separated addresses or
# ranges): the firewall's address, plus the Docker network. The default is every private range.
QBL_TRUSTED_PROXIES=

# ---- Sign in with Google -----------------------------------------------------------------
# From the Google Cloud console (APIs & Services > Credentials > OAuth client ID, "Web application").
# Authorised redirect URI:  https://your-host/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these domains may sign in with Google (comma-separated). Empty: any Google account.
QBL_GOOGLE_DOMAINS=
# New accounts at these domains start as teachers and can use the editor. Others start as students.
QBL_GOOGLE_TEACHER_DOMAINS=


# ---- AI scenario generator (php artisan qbl:generate) -----------------------------------------
# Every setting of the generator is here. Left empty, the default shown is used.
# See docs/docs/generation.md.

# Claude writes the mission, aligns it to standards and checks every picture against the art style.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
QBL_GEN_LLM_MODEL=claude-opus-5-5
QBL_GEN_JUDGE_MODEL=claude-sonnet-5-5

# What draws the pictures: gemini, openai, scenario, or placeholder (no service; for trying it out).
QBL_GEN_IMAGE_DRIVER=gemini

# Google Gemini. gemini-3-pro-image (Nano Banana Pro) or gemini-3.1-flash-image (Nano Banana 2, about half the price).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
QBL_GEN_GEMINI_MODEL=gemini-3.1-flash-image
# 1K, 2K or 4K
QBL_GEN_GEMINI_IMAGE_SIZE=2K

# OpenAI GPT Image. Quality: low, medium or high.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
QBL_GEN_OPENAI_MODEL=gpt-image-2
QBL_GEN_OPENAI_QUALITY=high

# Scenario (scenario.com), with a model trained on the house style.
SCENARIO_API_KEY=
SCENARIO_API_SECRET=
SCENARIO_MODEL_ID=
SCENARIO_BASE_URL=https://api.cloud.scenario.com/v1

# The art style: a folder in apps/api/resources/art-styles (qbl-adventure, qbl-cartoon).
QBL_GEN_STYLE=qbl-adventure
# Check every picture against the style's anchors, and redraw below this score (out of 10).
QBL_GEN_JUDGE=true
QBL_GEN_JUDGE_MIN_SCORE=7
QBL_GEN_MAX_ATTEMPTS=3

# The most one mission may have.
QBL_GEN_MAX_SCENES=8
QBL_GEN_MAX_CHARACTERS=6
QBL_GEN_MAX_ITEMS=14

# Where standards are imported from (php artisan qbl:standards). A JSON file needs neither.
LEARNING_COMMONS_API_KEY=
LEARNING_COMMONS_BASE_URL=https://api.learningcommons.org/knowledge-graph/v0
CSP_API_KEY=
CSP_BASE_URL=https://api.commonstandardsproject.com/api/v1
