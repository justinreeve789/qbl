# Development: the site is plain HTTP at http://localhost:QBL_APACHE_PORT (no certificate).
# On a server this port stays on the server's own loopback address; the edge (HTTPS) is the way in.
QBL_APACHE_PORT=8080
QBL_APACHE_BIND=127.0.0.1

# Set these for anything beyond your own machine. Without them, local-only defaults are used.
# DB_PASSWORD can be changed later: the db container applies it to the qbl account on restart.
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Shared secret between the Colyseus server and Laravel's /api/internal routes.
QBL_SERVICE_KEY=
# Laravel application key. Left empty, one is generated and kept in the app-data volume.
APP_KEY=

# Optional: "docker compose exec app php artisan qbl:seed" then also creates teacher@qbl.test,
# student1@qbl.test and student2@qbl.test with this password. The teacher can use the editor at /editor.
QBL_SEED_PASSWORD=
# The demo mission allows guests. Set to false to require accounts.
QBL_ALLOW_GUESTS=true
# Whether people may create their own account (name, email and password) instead of using Google.
# false: only Google, or accounts made with "php artisan qbl:user".
QBL_ALLOW_REGISTRATION=true
# Whether someone creating an account (with a password or with Google) may choose to be a teacher.
# false: every new account is a student's; make teachers with "php artisan qbl:update-role".
QBL_ALLOW_TEACHER_SIGNUP=true
# The game and marketing page are built by Vite when the app container starts. true: rebuilt on
# every change to apps/client or packages/shared. false: built once per start (servers).
QBL_CLIENT_WATCH=true

# ---- Email (choosing a new password) ---------------------------------------------------
# "Forgot your password?" emails a link. With MAIL_MAILER=log (the default) nothing is sent: the
# link is written to the app container's log (docker compose logs app). For real mail, use smtp
# with your provider's server, for example:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.example.com
#   MAIL_PORT=587
#   MAIL_USERNAME=...
#   MAIL_PASSWORD=...
#   MAIL_FROM_ADDRESS=no-reply@dev.questlab.cc
# MAIL_SCHEME=smtps for port 465. Without mail, an administrator can still make a link for someone:
#   docker compose exec app php artisan qbl:reset-link student@school.org
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=QuestLab
# What the site calls itself in those emails.
QBL_SITE_NAME=QuestLab

# ---- HTTPS (staging and production only) ------------------------------------------------
# Development needs none of this: leave COMPOSE_PROFILES and QBL_PUBLIC_URL empty.
# On a server, both of these start the "edge" container on ports 80 and 443. It ends HTTPS and
# everything behind it speaks plain HTTP. See "HTTPS" in the README.
#   COMPOSE_PROFILES=https
#   QBL_PUBLIC_URL=https://dev.questlab.cc
COMPOSE_PROFILES=
QBL_PUBLIC_URL=
# The edge's public ports and the address they listen on. The defaults (80, 443, every address)
# are what a server needs; Let's Encrypt needs port 80 or 443.
#   QBL_HTTP_PORT=80
#   QBL_HTTPS_PORT=443
#   QBL_HTTP_BIND=0.0.0.0
# Optional: Let's Encrypt writes here about problems with the certificate.
QBL_ACME_EMAIL=
# Your own certificate, if you use one instead of Let's Encrypt. QBL_CERTS_DIR is the folder
# mounted into the edge container; QBL_TLS_CERT and QBL_TLS_KEY are files inside it. Leave the
# two empty to use fullchain.pem and privkey.pem from that folder, or Let's Encrypt if absent.
# With certbot, mount all of /etc/letsencrypt so its live/ -> archive/ symlinks work:
#   QBL_CERTS_DIR=/etc/letsencrypt
#   QBL_TLS_CERT=/etc/letsencrypt/live/dev.questlab.cc/fullchain.pem
#   QBL_TLS_KEY=/etc/letsencrypt/live/dev.questlab.cc/privkey.pem
QBL_CERTS_DIR=./certs
QBL_TLS_CERT=
QBL_TLS_KEY=
# Whose X-Forwarded-For / X-Forwarded-Proto headers Laravel believes (comma-separated addresses
# or ranges). Laravel only ever hears from Apache, so this must include the Docker network; the
# default is every private range.
QBL_TRUSTED_PROXIES=

# ---- Sign in with Google -----------------------------------------------------------------
# From the Google Cloud console (APIs & Services > Credentials > OAuth client ID, "Web application").
# Authorised redirect URI:  https://your-host/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these domains may sign in with Google (comma-separated). Empty: any Google account.
QBL_GOOGLE_DOMAINS=


# ---- Characters' voices (the tts container; php artisan qbl:voice) -----------------------------
# What characters say is recorded once, with the time of every word, so the game lights each word
# as it is spoken. kokoro: the tts container (free, on this server). openai: any service with an
# OpenAI-style /v1/audio/speech (no word timings: words are lit at an even pace). none: nothing is
# recorded and the browser's own voice reads every line. See docs/.../developers/voices.md.
QL_TTS_DRIVER=kokoro
# Kokoro-FastAPI. In Docker Compose, the tts container.
QL_TTS_URL=http://tts:8880
# Only for a Kokoro-FastAPI started with API_KEYS (not the tts container here).
QL_TTS_API_KEY=
# How strongly theatrical voices (giants, pixies, pantomime villains) are chosen when characters are
# given voices. 3: a larger-than-life cast by default. 0: everyday voices unless a character calls
# for more. Higher: theatrical nearly always.
QL_TTS_FLAIR=3
# The tts container's image: ...-cpu (default) or, with an NVIDIA GPU, ghcr.io/remsky/kokoro-fastapi-gpu:v0.10.0
QL_TTS_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:v0.10.0
# The narrator: what no character says is recorded in this voice (a key of the voice catalog) in
# scenarios that choose none. Empty: "storyteller" (dramatic, charismatic) in English, and the
# catalog's narrator for each other language.
QL_TTS_NARRATOR=
# With QL_TTS_DRIVER=openai. The key defaults to OPENAI_API_KEY.
QL_TTS_OPENAI_URL=https://api.openai.com
QL_TTS_OPENAI_KEY=
QL_TTS_OPENAI_MODEL=gpt-4o-mini-tts

# ---- AI scenario generator (php artisan qbl:generate) -----------------------------------------
# Every setting of the generator is here. Left empty, the default shown is used.
# See docs/src/content/docs/developers/generation.mdx.

# Claude writes the mission, aligns it to standards and checks every picture against the art style.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
QBL_GEN_LLM_MODEL=claude-opus-5-5
QBL_GEN_JUDGE_MODEL=claude-sonnet-5-5
# Choosing standards and writing objectives: a smaller job, a cheaper model.
QBL_GEN_ALIGN_MODEL=claude-sonnet-5-5
# The models think before answering (Opus 5.5 always does), and thinking counts toward each answer's
# token limit: this much room is added for it (a ceiling; unused room costs nothing). If a run says the
# model "ran out of room", raise it (the most is 128000 with the answer) or lower the effort.
QBL_GEN_THINKING_TOKENS=32000
# How hard the models think: low, medium, high, xhigh or max. Empty = each model's default.
QBL_GEN_LLM_EFFORT=
# Seconds to wait for one answer from the model.
QBL_GEN_LLM_TIMEOUT=1800

# What draws the pictures: gemini, openai, scenario, or placeholder (no service; for trying it out).
QBL_GEN_IMAGE_DRIVER=gemini

# Google Gemini. gemini-3-pro-image (Nano Banana Pro) or gemini-3.1-flash-image (Nano Banana 2, about half the price).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
QBL_GEN_GEMINI_MODEL=gemini-3.1-flash-image
# 1K, 2K or 4K
QBL_GEN_GEMINI_IMAGE_SIZE=2K
# Small cut-outs (things, sheets of things, doors and holes, the badge): a cheaper model and size.
# Set the model to the main one to draw everything with it.
QBL_GEN_GEMINI_PROPS_MODEL=gemini-3.1-flash-image
QBL_GEN_GEMINI_PROPS_SIZE=1K

# OpenAI GPT Image. Quality: low, medium or high.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
QBL_GEN_OPENAI_MODEL=gpt-image-2
QBL_GEN_OPENAI_QUALITY=high

# Scenario (scenario.com), with a model trained on the house style.
SCENARIO_API_KEY=
SCENARIO_API_SECRET=
SCENARIO_MODEL_ID=
SCENARIO_BASE_URL=https://api.cloud.scenario.com/v1

# The art style: a folder in apps/api/resources/art-styles (qbl-adventure, qbl-cartoon).
QBL_GEN_STYLE=qbl-adventure
# Check every picture against the style's anchors, and redraw below this score (out of 10).
QBL_GEN_JUDGE=true
QBL_GEN_JUDGE_MIN_SCORE=7
QBL_GEN_MAX_ATTEMPTS=3

# Cost. Most a run may spend on AI services, in US dollars, estimated from list prices (0 for no budget).
# Past it nothing is redrawn and extras are skipped; at twice it the run stops (resume with --budget=...).
QBL_GEN_BUDGET_USD=5
# List prices if they change, as JSON (see Spend::PRICES), e.g. {"gemini-3-pro-image@2K": 0.134}
QBL_GEN_PRICES=
# crop: portraits are cut from the character sheet (free); draw: one more picture per character.
QBL_GEN_PORTRAITS=crop
# Draw a breathing idle animation per character (otherwise the standing picture is the idle).
QBL_GEN_IDLE_FRAMES=false
# Draw small things several to a picture, cut apart (instead of one picture each).
QBL_GEN_PROP_SHEETS=true
# Send a scale guide (the floor and child-sized figures) with each background, so scenery matches people.
QBL_GEN_SCALE_GUIDE=true
# How many missions (0 to 1) may have a big tense moment: a character falls or is trapped and students save them.
QBL_GEN_BIG_MOMENT_CHANCE=0.25

# The most one mission may have.
QBL_GEN_MAX_SCENES=8
QBL_GEN_MAX_CHARACTERS=6
QBL_GEN_MAX_ITEMS=18

# Where standards are imported from (php artisan qbl:standards). A JSON file needs neither.
LEARNING_COMMONS_API_KEY=
LEARNING_COMMONS_BASE_URL=https://api.learningcommons.org/knowledge-graph/v0
CSP_API_KEY=
CSP_BASE_URL=https://api.commonstandardsproject.com/api/v1


# ---- Plans and billing (Stripe) ------------------------------------------------------------
# Off (the default): everyone may play every mission, have any number of students, and use the
# generator without credits. On: Free (free missions), Teacher ($30/month: curricular missions, up
# to 40 students) and Teacher Plus ($50/month: also the AI generator, with monthly credits), each
# with a 7-day free trial. Schools and districts ask for a quote (Plans page) and get a license
# (php artisan qbl:org license). See "Plans and billing" in the README.
QBL_BILLING_ENABLED=false
# From the Stripe dashboard (Developers > API keys). Use sk_test_... to try it out.
STRIPE_SECRET=
# The webhook endpoint https://your-host/api/billing/webhook's signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=
# The two monthly prices: php artisan qbl:billing setup makes them and prints these lines.
STRIPE_PRICE_TEACHER=
STRIPE_PRICE_TEACHER_PLUS=
# Stripe Tax at checkout (set it up in Stripe first).
STRIPE_AUTOMATIC_TAX=false
QBL_TRIAL_DAYS=7
# true: a card is taken when the trial starts. false: no card until the trial ends.
QBL_TRIAL_REQUIRES_CARD=true
# Buying a teacher plan makes a student account (the kind the sign-in page makes) a teacher.
QBL_BILLING_PROMOTES_TO_TEACHER=true
# How many students a teacher may have on Free, and on the teacher plans.
QBL_FREE_STUDENT_LIMIT=0
QBL_TEACHER_STUDENT_LIMIT=40
# What the pages show (keep equal to the Stripe prices).
QBL_PRICE_TEACHER=30
QBL_PRICE_TEACHER_PLUS=50
# AI generator credits on Teacher Plus: added each billing month; unused ones carry over up to the
# carry-over limit. A generated mission costs QBL_CREDITS_PER_GENERATION.
QBL_PLUS_MONTHLY_CREDITS=100
QBL_PLUS_CREDIT_CARRYOVER=100
QBL_PLUS_TRIAL_CREDITS=20
QBL_CREDITS_PER_GENERATION=10
# Where "Contact us for a quote" requests are emailed (they are kept in quote_requests either way).
QBL_SALES_EMAIL=
# A number schools and districts can call about a quote, shown on the plans page (optional).
QBL_SALES_PHONE=

# ---- The queue worker -----------------------------------------------------------------------
# The app container runs one, for the editor's AI generations and the district panel's syncs.
QBL_QUEUE_WORKER=true

# ---- District admin panel: Clever ---------------------------------------------------------
# QBL's application in Clever (https://apps.clever.com), for Instant Login and Secure Sync.
# Redirect URI to register: https://your-host/api/sso/clever/callback
# SAML and Google Classroom need nothing here: each district sets them up in its panel.
CLEVER_CLIENT_ID=
CLEVER_CLIENT_SECRET=
