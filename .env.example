# Port the site is published on.
QBL_HTTP_PORT=8080

# Set these for anything beyond your own machine. Without them, local-only defaults are used.
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Shared secret between the Colyseus server and Laravel's /api/internal routes.
QBL_SERVICE_KEY=
# Laravel application key. Left empty, one is generated and kept in the app-data volume.
APP_KEY=

# Optional: creates teacher@qbl.test, student1@qbl.test and student2@qbl.test with this password.
# The teacher account can sign in to the editor at /editor.
QBL_SEED_PASSWORD=
# The demo mission allows guests. Set to false to require accounts.
QBL_ALLOW_GUESTS=true
# true: seed the demo mission if it is not in the database yet (edits to it are kept across restarts).
# reset: put the shipped demo back, replacing edits to it.  false: do not seed.
QBL_SEED=true
